# Copie para .env e ajuste os valores
SECRET_KEY=troque-esta-chave
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Serviços (django-service-urls). Sem DATABASE_URL, usa o SQLite local.
# No Docker Compose, DATABASE_URL é montada a partir das variáveis POSTGRES_*.
# DATABASE_URL=postgres://usuario:senha@localhost:5432/smartworker
# CACHE_URL=memory://
# Mídia (planilhas de disponibilidade). fs:// grava em MEDIA_ROOT; em produção
# sem disco persistente (ex: Railway), use um bucket S3 ou compatível:
# STORAGE_DEFAULT=s3://?bucket_name=smartworker-media
# STORAGE_DEFAULT=fs://
# STORAGE_STATICFILES=whitenoise+static://
# MAILER_URL=console://

# Credenciais do bucket, lidas pelo boto3 (no Railway, vêm das variáveis do bucket)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_ENDPOINT_URL=https://...   # só para serviços compatíveis com S3 (R2, Railway, MinIO...)

# Atrás de um proxy que termina o HTTPS (Railway, nginx com X-Forwarded-Proto)
# TRUST_X_FORWARDED_PROTO=1

# Usadas pelo serviço "db" do Docker Compose
POSTGRES_DB=smartworker
POSTGRES_USER=smartworker
POSTGRES_PASSWORD=troque-esta-senha

# Pastas do host servidas pelo nginx (montadas no container web)
# STATIC_HOST_DIR=/var/www/smartworker/static
# MEDIA_HOST_DIR=/var/www/smartworker/media
